name: Docker Image CI
on:
  push:
    branches: ["main", "feature-selfdepoly"]  # 仅main分支推送时触发
jobs:
  build-push:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3  # 支持多架构构建
      - name: Log in to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKER_USERNAME }}  # 仓库用户名
          password: ${{ secrets.DOCKER_PASSWORD }}   # 仓库密码/Token
      - name: Build and push
        uses: docker/build-push-action@v5
        with:
          context: .                # 构建上下文路径
          push: false                # 自动推送镜像
          file: ./docker/Dockerfile
          tags: YU-7/gitstars:${{ github.sha }}, YU-7/gitstars:latest  # 标签策略
